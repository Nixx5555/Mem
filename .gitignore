# Office lock files
~$*

# Private settings: the Anthropic key setup saves. Never commit it.
.env
.env.*
!.env.example

# Downloaded artefacts — reproducible, not source. See memgate/README.md.
# all-MiniLM-L6-v2 (~90 MB) and Qwen2.5-0.5B-Instruct (~942 MB)
memgate/models/
# locomo10.json, 2.7 MB, from snap-research/locomo
memgate/data/locomo/
# longmemeval_s_cleaned.json (265 MB) and longmemeval_oracle.json (15 MB),
# from xiaowu0162/LongMemEval. The 265 MB file exceeds GitHub's per-file
# limit on its own; both are downloaded artefacts, same as locomo/ above.
memgate/data/longmemeval/
# REALTALK Chat_*.json (10 files, 3.2 MB), from danny911kr/REALTALK data/.
memgate/data/realtalk/
# BEAM 100K and 500K chats (chat.json + probing_questions.json, 96 MB), from
# mohammadtavakoli78/BEAM chats/<scale>/<n>/.
memgate/data/beam/
# MemBench (MemData/, 775 MB with the repo), from import-myself/Membench.
memgate/data/membench
# PersonaChat (personachat_self_original.json, 200 MB), from s3.amazonaws.com/datasets.huggingface.co.
memgate/data/personachat/
# retrain_scorer.py's saved MiniLM embeddings, rebuildable
memgate/data/cache/

# Results are committed: a reviewer should see fig1-fig5 and every number
# REPORT.md cites without a 9-minute LoCoMo run. The judge/reader CACHES are
# not — they are a local generation cache keyed by (model, prompt) hash,
# rebuildable and worth ~320 KB of churn per run.
memgate/results/*cache*.json

__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store

# Overleaf upload bundle: a zip of paper/, rebuilt by paper/bundle.sh.
# Everything inside it is already tracked; committing it would duplicate the repo.
MemGate_paper_overleaf.zip

# Intermediate for the two-phase end-task run (22 MB): assembled contexts,
# regenerated by `run_endtask.py --dump-contexts`. The generations it feeds are
# cached in endtask_cache.json, and the result is endtask.csv; both are kept.
memgate/results/endtask_contexts.json

# LaTeX build artefacts. paper/main.pdf and paper/journal.pdf ARE committed --
# they are the deliverables, and the same reasoning that keeps fig1-fig5
# applies. Everything else is regenerated by every compile.
paper/*.log
paper/*.blg
paper/*.aux
paper/*.bbl
paper/*.out

# Saved conversations from app.py: personal, not source.
memgate/chats/
