# MemGate private settings. Copy this file to .env (or let setup write it).
# .env is gitignored, so what you put there stays on this laptop.

# Optional. With a key, Claude writes the replies; without one, the local
# Qwen model does. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides (the same as the app's command-line options).
# MEMGATE_LLM=auto            # auto | claude | mlx | hf | none
# MEMGATE_SCORER=learned      # learned | heuristic
# MEMGATE_CLAUDE_MODEL=claude-opus-5-5
